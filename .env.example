# ---- App ----
APP_NAME=Project Management Microservice
APP_VERSION=1.0.0
DEBUG=True

# ---- Database ----
# SQLite (default — zero setup)
DATABASE_URL=sqlite+aiosqlite:///./project_management.db
# Postgres (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/project_management_db
SQLALCHEMY_ECHO=False

# ---- Security / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- CORS ----
# Comma-separated origins. Use "*" for any (dev only).
CORS_ORIGINS=*

# ---- Sibling microservices (leave empty if not deployed yet) ----
INGESTION_SERVICE_URL=https://mod2eng.azurewebsites.net/
REPORTS_SERVICE_URL=https://moduloderelatorios.azurewebsites.net
PRESENTATIONS_SERVICE_URL=
DIAGRAMS_SERVICE_URL=https://modulo5-interface-e-nuvem.azurewebsites.net/
CHAT_SERVICE_URL=
